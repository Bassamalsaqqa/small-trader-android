{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/offline-sale-intake-request.json",
  "title": "OfflineSaleIntakeRequest",
  "type": "object",
  "required": ["client_event_id", "device_id", "captured_at", "payload_digest", "event"],
  "properties": {
    "client_event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "required": [
        "client_event_id",
        "device_id",
        "captured_at",
        "customer_id",
        "currency",
        "catalog_snapshot_version",
        "local_receipt_number",
        "lines",
        "payment"
      ],
      "properties": {
        "client_event_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "catalog_snapshot_version": {
          "type": "string",
          "minLength": 1
        },
        "local_receipt_number": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["product_id", "quantity", "unit_price", "tax_rate", "tax_amount", "line_total"],
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "quantity": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              "unit_price": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              "tax_rate": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "tax_amount": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              "line_total": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            },
            "additionalProperties": false
          }
        },
        "payment": {
          "type": "object",
          "required": ["mode", "amount_tendered", "amount_settled", "change_returned"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["cash"]
            },
            "amount_tendered": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "amount_settled": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "change_returned": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
