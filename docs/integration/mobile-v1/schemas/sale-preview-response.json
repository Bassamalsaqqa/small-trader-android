{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/sale-preview-response.json",
  "title": "SalePreviewResponse",
  "type": "object",
  "required": [
    "company_id",
    "customer_id",
    "currency",
    "subtotal",
    "tax_total",
    "grand_total",
    "amount_due",
    "change",
    "lines",
    "preview_token",
    "expires_at"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "tax_total": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "grand_total": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]{0,5}[1-9]|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
    },
    "amount_due": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "change": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "quantity",
          "unit_price",
          "tax_rate",
          "tax_amount",
          "line_total"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{0,3}[1-9]|[1-9][0-9]{0,9}(?:\\.[0-9]{1,4})?)$"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "tax_rate": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,4})?$"
          },
          "tax_amount": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "line_total": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{0,5}[1-9]|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
          }
        },
        "additionalProperties": false
      }
    },
    "preview_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 16384
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
